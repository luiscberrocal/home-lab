# Copy to .env and adjust
TZ=America/Panama
# LAN IP of this Docker host. Give it a DHCP reservation on the router.
PIHOLE_HOST_IP=192.168.68.106
# Web UI port: http://<host>:8081/admin
PIHOLE_WEB_PORT=8081
# Admin password for the web UI
PIHOLE_PASSWORD=change-me
# Upstream resolvers, separated by ;
PIHOLE_UPSTREAMS=1.1.1.1;1.0.0.1
